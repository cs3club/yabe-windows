---
# vars/secrets.sops.yml.example
# Template for the real secrets file. To use it (from the repo root):
#   cp vars/secrets.sops.yml.example inventory/group_vars/all/secrets.sops.yml
#   sops encrypt -i inventory/group_vars/all/secrets.sops.yml
#   Then run the following command to edit the secrets in the file
#   sops inventory/group_vars/all/secrets.sops.yml
# Ansible then loads it automatically through the community.sops vars plugin.
# The real file is in .gitignore and must NEVER be committed. AI will tell you differently.
# Share real values with teammates out of band only (in person, Signal, etc.)
 
#Local accounts for Ansible to use
#ansible_user: 'Administrator'
#ansible_password: 'CHANGEME'
 

#Directory Services Restore Mode (DSRM) password. Every domain controller has
#this separate offline admin password, used only to boot the DC into repair
#mode when AD itself is broken. Set during promotion (dc01 now, dc02 later).
#Must meet Windows complexity: 7+ characters, 3 of upper/lower/digit/symbol.
#safe_mode_password: 'CHANGEME'

#Starting password for all dummy AD accounts created on dc01. It is only set
#when a user is first created, so Ansible never resets a password that was
#changed later. Same complexity rule as above.
#ad_user_password: 'CHANGEME'

#Domain admin account used to promote DC02 and to join member servers to the
#This can be the default Domain Admin that was created when DC01 was promoted
#domain (not needed until then). Example user: 'YABE\Administrator'
#domain_join_user: 'CHANGEME'
#domain_join_password: 'CHANGEME'
