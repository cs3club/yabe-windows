---
# vars/secrets.sops.yml.example
# Template for the real secrets file. To use it (from the repo root):
#   cp vars/secrets.sops.yml.example inventory/group_vars/all/secrets.sops.yml
#   sops encrypt -i inventory/group_vars/all/secrets.sops.yml
#   Then run the following command to edit the secrets in the file
#   sops inventory/group_vars/all/secrets.sops.yml
# Ansible then loads it automatically through the community.sops vars plugin.
# The real file is in .gitignore and must NEVER be committed. AI will tell you differently.
# Share real values with teammates out of band only (in person, Signal, etc.)
 
#Local accounts for Ansible to use
#ansible_user: 'Administrator'
#ansible_password: 'CHANGEME'
 
#At some point, we will need to include Active directory users in this file for certain tasks (like promoting DC02)
